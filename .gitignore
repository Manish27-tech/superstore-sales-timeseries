# Environments
.venv/
venv/
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Raw and intermediate data are reproducible from the pinned source
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# The dashboard feed is generated but committed: Streamlit Cloud needs it
!data/dashboard/

# Model binaries are rebuilt by the pipeline
artifacts/*
!artifacts/.gitkeep

# OS noise
.DS_Store
Thumbs.db
